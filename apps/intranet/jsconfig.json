{
  "extends": "../../jsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@macom/api-client": ["../../packages/api-client/src/index.js"],
      "@macom/api-client/*": ["../../packages/api-client/src/*"],
      "@macom/auth": ["../../packages/auth/src/index.js"],
      "@macom/auth/*": ["../../packages/auth/src/*"],
      "@macom/notifications": ["../../packages/notifications/src/index.js"],
      "@macom/notifications/*": ["../../packages/notifications/src/*"],
      "@macom/push": ["../../packages/push/src/index.js"],
      "@macom/push/*": ["../../packages/push/src/*"],
      "@macom/test-utils": ["../../packages/test-utils/src/index.js"],
      "@macom/test-utils/*": ["../../packages/test-utils/src/*"],
      "@macom/ui": ["../../packages/ui/src/index.js"],
      "@macom/ui/*": ["../../packages/ui/src/*"],
      "@macom/validation": ["../../packages/validation/src/index.js"],
      "@macom/validation/*": ["../../packages/validation/src/*"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
