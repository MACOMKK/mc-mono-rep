VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_SUPABASE_ANON_KEY
VITE_CONSOLE_URL=https://macom-console.vercel.app/
VITE_COMUNICACAO_URL=https://macom-comunicacao.vercel.app/
# Site key (publica) do widget Cloudflare Turnstile usado na tela de login.
# Sem essa variavel o CAPTCHA fica desativado (AuthLoginCard nao exige captchaToken).
VITE_TURNSTILE_SITE_KEY=

# Opcional: regiao de execucao da Edge Function crm-api (ex.: us-west-2, mesma regiao do banco).
# Vazio = Supabase escolhe a mais proxima do usuario. Ver packages/api-client/src/crmApi.js
VITE_CRM_API_REGION=
